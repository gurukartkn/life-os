# Copy to .env.local for the dev Supabase project (docs/03-architecture-decisions.md ADR-007).
# Production values are set in Vercel's Production environment, never committed.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Dedicated e2e test account against the dev Supabase project — provisioned
# automatically (pre-confirmed) by e2e/global-setup.ts on first Playwright run.
E2E_EMAIL=
E2E_PASSWORD=

# Sentry error tracking (docs/03-architecture-decisions.md ADR-008). Set the DSN in Vercel's
# Production environment only — previews and local runs then send nothing. The auth token
# (source-map upload at build time) is server-side only and never committed.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=   # optional label; leave empty in Production
